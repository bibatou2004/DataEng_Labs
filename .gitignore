cat <<EOF > .gitignore
# --- DATA & OUTPUTS  ---
data/
outputs/
*.parquet
*.gz


# --- ARCHIVES ---
*.zip
*.tar
*.rar

# --- PYTHON & NOTEBOOKS ---
__pycache__/
*.pyc
.ipynb_checkpoints/

# --- ENVIRONNEMENTS ---
env/
venv/
miniconda3/
.conda/

# --- SYSTEME & IDE ---
.DS_Store
.vscode/
EOF
# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
*.egg-info/
dist/
build/

# Jupyter
.ipynb_checkpoints
*.ipynb_checkpoints

# Spark
metastore_db/
warehouse/
spark-warehouse/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Data
data/
!output/

# Logs
*.log
logs/

# Temporary
*.tmp
temp/

# Node
node_modules/
npm-debug.log

# Environment
.env
.env.local
